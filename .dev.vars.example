# Copy to `.dev.vars` (git-ignored) for local development.
# `npm run dev` starts a loopback bridge at this address. OpenAI and
# Anthropic authenticate through `codex login` and `claude auth login`, so no
# API keys are stored in PromptForge.
PROMPTFORGE_BRIDGE_URL=http://127.0.0.1:4317

# Optional: Google remains API-backed because it has no subscription CLI.
GOOGLE_API_KEY=

# Leave unset to close signup once the owner account exists.
# Set it to let other people create accounts with this code.
SIGNUP_INVITE_CODE=
